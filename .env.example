# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Turso (libSQL) Permanent Cloud Database (required for Render / production persistence)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Override initial Super Owner credentials before first boot
INITIAL_OWNER_ID=
INITIAL_OWNER_MOBILE=
INITIAL_OWNER_PASSWORD=

# Optional: Override secret verification password for Owner/Admin registration
STAFF_VERIFICATION_PASSWORD=
