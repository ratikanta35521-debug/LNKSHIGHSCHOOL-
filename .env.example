# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Override initial Super Owner credentials before first boot
INITIAL_OWNER_ID=
INITIAL_OWNER_MOBILE=
INITIAL_OWNER_PASSWORD=

# Optional: Override fixed verification password for Owner/Admin registration
STAFF_VERIFICATION_PASSWORD=

# Optional: Persistent HMAC secret for signed session tokens
SESSION_SECRET=
